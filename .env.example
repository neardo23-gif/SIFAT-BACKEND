# --- MySQL (Amazon RDS) ---
DB_HOST=rds-sifat-db.c1hvn5sjqeur.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=sifat
# Usuario con permisos mínimos (ver sql/02_usuario_app.sql). Nunca uses admin aquí.
DB_USER=sifat_app
DB_PASSWORD=
# Certificado de AWS para conexión cifrada (ver README)
DB_SSL_CA=certs/global-bundle.pem

# --- Catálogo de servicios (API Gateway + DynamoDB) ---
SERVICIOS_API_URL=https://4er7ekb4h6.execute-api.us-east-1.amazonaws.com/dev
SERVICIOS_API_KEY=

# --- Seguridad del backend ---
# Clave que el frontend manda en el header X-API-Key. Genera una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_API_KEY=
# true solo en desarrollo: muestra la documentación en /docs
ENABLE_DOCS=false
